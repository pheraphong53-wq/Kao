<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Bemo🤖ระบาด!</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #1a1a1a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }
        /* หน้าจอเปิดตัว (Intro & Menu) */
        #menu {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #1b4d3e, #0f2d23);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
            transition: opacity 1s ease;
            color: #fff;
            text-align: center;
        }
        #menu h1 {
            font-size: 36px;
            color: #4ade80;
            margin-bottom: 10px;
            text-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        #menu p {
            color: #a3e635;
            font-size: 14px;
            margin-bottom: 30px;
        }
        .btn-play {
            background-color: #22c55e;
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 20px;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
            transition: 0.2s;
        }
        .btn-play:active {
            transform: scale(0.95);
            background-color: #16a34a;
        }

        /* หน้าจอเล่นเกม (UI ในเกม) */
        #gameUI {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            pointer-events: none;
            z-index: 5;
        }
        /* เป้าเล็งตรงกลาง */
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 10px;
            height: 10px;
            border: 2px solid rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            transform: translate(-50%, -50%);
        }
        /* คะแนนและกระสุน */
        #hud {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            font-size: 16px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
        }
        /* ปุ่มยิงและปุ่มเดินสำหรับมือถือ */
        .touch-controls {
            position: absolute;
            bottom: 20px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 20px;
            box-sizing: border-box;
            pointer-events: auto;
        }
        .d-pad {
            display: grid;
            grid-template-columns: repeat(3, 50px);
            gap: 5px;
        }
        .ctrl-btn {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: white;
            font-size: 18px;
            font-weight: bold;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }
        .ctrl-btn:active { background: rgba(255, 255, 255, 0.4); }
        .btn-fire {
            width: 80px;
            height: 80px;
            background: #ef4444;
            border: 2px solid #fecaca;
            color: white;
            font-size: 16px;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.5);
            cursor: pointer;
            pointer-events: auto;
        }
        .btn-fire:active { transform: scale(0.9); background: #dc2626; }
    </style>
    <!-- โหลดไลบรารี Three.js สำหรับสร้างโลก 3D -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- ฉากเปิดตัว -->
    <div id="menu">
        <h1>Bemo🤖ระบาด!</h1>
        <p>ระวังฝูงปีศาจ Bemo บุกโจมตีทุ่งหญ้า!</p>
        <button class="btn-play" onclick="startGame()">PLAY</button>
    </div>

    <!-- UI ในเกม -->
    <div id="gameUI">
        <div id="crosshair"></div>
        <div id="hud">
            <div>🎯 คะแนน: <span id="score">0</span></div>
            <div>🔫 กระสุน: ไม่จำกัด (∞)</div>
        </div>
        
        <div class="touch-controls">
            <div class="d-pad">
                <div></div>
                <div class="ctrl-btn" ontouchstart="movePlayer('W')" onmousedown="movePlayer('W')">⬆️</div>
                <div></div>
                <div class="ctrl-btn" ontouchstart="movePlayer('A')" onmousedown="movePlayer('A')">⬅️</div>
                <div class="ctrl-btn" ontouchstart="movePlayer('S')" onmousedown="movePlayer('S')">⬇️</div>
                <div class="ctrl-btn" ontouchstart="movePlayer('D')" onmousedown="movePlayer('D')">➡️</div>
            </div>
            <button class="btn-fire" onclick="shootGun()">💥 ยิง!</button>
        </div>
    </div>

    <script>
        let scene, camera, renderer;
        let player = { x: 0, z: 0, rotY: 0 };
        let monsters = [];
        let score = 0;
        let gameActive = false;

        function startGame() {
            // ซ่อนหน้าจอเมนูแบบเฟดออก
            const menu = document.getElementById('menu');
            menu.style.opacity = '0';
            setTimeout(() => {
                menu.style.display = 'none';
                document.getElementById('gameUI').style.display = 'block';
                initGame3D();
                gameActive = true;
            }, 1000);
        }

        function initGame3D() {
            // สร้างซีน 3D
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87ceeb); // ท้องฟ้าสีฟ้าสดใส
            scene.fog = new THREE.FogExp2(0x87ceeb, 0.015);

            // กล้อง (มุมมองผู้เล่น First-Person / ตัวละครถือปืน)
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 1.6, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.body.appendChild(renderer.domElement);

            // แสงสว่าง
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);
            const sunLight = new THREE.DirectionalLight(0xfffaed, 0.8);
            sunLight.position.set(50, 100, 50);
            scene.add(sunLight);

            // พื้นหญ้าสุดลูกหูลูกตา
            const floorGeo = new THREE.PlaneGeometry(1000, 1000);
            const floorMat = new THREE.MeshLambertMaterial({ color: 0x38a169 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            scene.add(floor);

            // สร้างปีศาจ Bemo 3D ชุดแรก
            for (let i = 0; i < 5; i++) {
                spawnMonster();
            }

            // ระบบหมุนมองจอด้วยการลากนิ้วบนหน้าจอ
            let isDragging = false;
            let prevMouseX = 0;

            window.addEventListener('pointerdown', (e) => {
                if(!gameActive) return;
                isDragging = true;
                prevMouseX = e.clientX;
            });

            window.addEventListener('pointermove', (e) => {
                if (!isDragging || !gameActive) return;
                let deltaX = e.clientX - prevMouseX;
                player.rotY -= deltaX * 0.005;
                camera.rotation.y = player.rotY;
                prevMouseX = e.clientX;
            });

            window.addEventListener('pointerup', () => { isDragging = false; });

            // เริ่มลูปเกม
            animate();
        }

        // สร้างปีศาจสไตล์ Bemo 3D
        function spawnMonster() {
            const monsterGroup = new THREE.Group();

            // ตัวเครื่อง Bemo (สีเขียวพาสเทลตามรูป)
            const bodyGeo = new THREE.BoxGeometry(1.2, 1.8, 0.6);
            const bodyMat = new THREE.MeshLambertMaterial({ color: 0x86efac });
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            body.position.y = 0.9;
            monsterGroup.add(body);

            // หน้าจอ Bemo (สีฟ้าอมเขียว)
            const screenGeo = new THREE.BoxGeometry(0.9, 0.9, 0.1);
            const screenMat = new THREE.MeshLambertMaterial({ color: 0x0ea5e9 });
            const screen = new THREE.Mesh(screenGeo, screenMat);
            screen.position.set(0, 1.1, 0.31);
            monsterGroup.add(screen);

            // สุ่มตำแหน่งเกิดรอบๆ ผู้เล่น
            let angle = Math.random() * Math.PI * 2;
            let distance = 25 + Math.random() * 20;
            monsterGroup.position.x = player.x + Math.cos(angle) * distance;
            monsterGroup.position.z = player.z + Math.sin(angle) * distance;

            scene.add(monsterGroup);

            // เก็บข้อมูลมอนสเตอร์ (เลือด 5 นัด)
            monsters.push({
                mesh: monsterGroup,
                health: 5,
                speed: 0.04 + Math.random() * 0.02 // เดินช้าแต่ไม่ช้ามาก
            });
        }

        // ควบคุมการเดิน
        function movePlayer(direction) {
            if (!gameActive) return;
            const speed = 0.6;
            if (direction === 'W') {
                player.x -= Math.sin(player.rotY) * speed;
                player.z -= Math.cos(player.rotY) * speed;
            } else if (direction === 'S') {
                player.x += Math.sin(player.rotY) * speed;
                player.z += Math.cos(player.rotY) * speed;
            } else if (direction === 'A') {
                player.x -= Math.cos(player.rotY) * speed;
                player.z += Math.sin(player.rotY) * speed;
            } else if (direction === 'D') {
                player.x += Math.cos(player.rotY) * speed;
                player.z -= Math.sin(player.rotY) * speed;
            }
            camera.position.x = player.x;
            camera.position.z = player.z;
        }

        // ระบบยิงปืน
        function shootGun() {
            if (!gameActive) return;
            
            // เช็คว่ามอนสเตอร์ตัวไหนอยู่ใกล้แนวเล็งตรงกลางจอ
            for (let i = monsters.length - 1; i >= 0; i--) {
                let m = monsters[i];
                let dist = camera.position.distanceTo(m.mesh.position);
                
                // ถ้ายิงโดนในระยะ
                if (dist < 20) {
                    m.health -= 1; // ลดเลือด 1 นัด
                    
                    // เอฟเฟกต์แฟลชเมื่อโดนยิง (ตัวกระพริบแดง)
                    m.mesh.children[0].material.color.setHex(0xef4444);
                    setTimeout(() => {
                        if(m.mesh) m.mesh.children[0].material.color.setHex(0x86efac);
                    }, 150);

                    // ถ้าเลือดหมด 5 นัด ปีศาจตาย
                    if (m.health <= 0) {
                        scene.remove(m.mesh);
                        monsters.splice(i, 1);
                        score += 10;
                        document.getElementById('score').innerText = score;
                        
                        // เกิดตัวใหม่ทดแทน
                        setTimeout(spawnMonster, 1000);
                    }
                    break; // ยิงโดน 1 ตัวต่อการคลิก
                }
            }
        }

        // อัปเดตเฟรมเกมทุกๆ วินาที
        function animate() {
            if (!gameActive) return;
            requestAnimationFrame(animate);

            // ให้ปีศาจเดินเข้าหาผู้เล่นตลอดเวลา
            monsters.forEach(m => {
                m.mesh.lookAt(camera.position.x, m.mesh.position.y, camera.position.z);
                m.mesh.translateZ(m.speed);
            });

            renderer.render(scene, camera);
        }

        // ปรับขนาดหน้าจออัตโนมัติ
        window.addEventListener('resize', () => {
            if(!camera) return;
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
